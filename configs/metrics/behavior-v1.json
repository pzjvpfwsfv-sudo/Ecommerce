{
  "domain": "behavior",
  "dataset_id": "rees46-multicategory",
  "metric_version": "behavior-v1",
  "definitions": [
    {
      "metric_name": "event_count",
      "display_name": "有效行为事件数",
      "formula": "count(*)",
      "numerator": "all valid facts",
      "denominator": null,
      "source_fields": ["event_id"],
      "allowed_windows": ["DAY", "FULL"],
      "additive": true,
      "null_policy": "event_id must be non-empty",
      "limitations": ["The correctness subset is not the full sampled population."],
      "forbidden_claims": []
    },
    {
      "metric_name": "view_count",
      "display_name": "浏览事件数",
      "formula": "count(*) where event_type = 'view'",
      "numerator": "view events",
      "denominator": null,
      "source_fields": ["event_type", "event_id"],
      "allowed_windows": ["DAY", "FULL"],
      "additive": true,
      "null_policy": "event_id must be non-empty",
      "limitations": ["Only valid behavior facts are included."],
      "forbidden_claims": []
    },
    {
      "metric_name": "cart_count",
      "display_name": "加购事件数",
      "formula": "count(*) where event_type = 'cart'",
      "numerator": "cart events",
      "denominator": null,
      "source_fields": ["event_type", "event_id"],
      "allowed_windows": ["DAY", "FULL"],
      "additive": true,
      "null_policy": "event_id must be non-empty",
      "limitations": ["Only valid behavior facts are included."],
      "forbidden_claims": []
    },
    {
      "metric_name": "purchase_count",
      "display_name": "购买事件数",
      "formula": "count(*) where event_type = 'purchase'",
      "numerator": "purchase events",
      "denominator": null,
      "source_fields": ["event_type", "event_id"],
      "allowed_windows": ["DAY", "FULL"],
      "additive": true,
      "null_policy": "event_id must be non-empty",
      "limitations": ["A purchase event does not establish payment completion."],
      "forbidden_claims": ["订单数", "支付订单数"]
    },
    {
      "metric_name": "unique_user_count",
      "display_name": "去重用户数",
      "formula": "count(distinct user_id) where user_id is not null",
      "numerator": "distinct non-null user_id",
      "denominator": null,
      "source_fields": ["user_id"],
      "allowed_windows": ["DAY", "FULL"],
      "additive": false,
      "null_policy": "null user_id is excluded",
      "limitations": ["DAY values cannot be summed to obtain an exact multi-day value."],
      "forbidden_claims": []
    },
    {
      "metric_name": "session_count",
      "display_name": "去重会话数",
      "formula": "count(distinct user_session) where user_session is not null",
      "numerator": "distinct non-null user_session",
      "denominator": null,
      "source_fields": ["user_session"],
      "allowed_windows": ["DAY", "FULL"],
      "additive": false,
      "null_policy": "null user_session is excluded",
      "limitations": ["DAY values cannot be summed to obtain an exact multi-day value."],
      "forbidden_claims": []
    },
    {
      "metric_name": "product_count",
      "display_name": "去重商品数",
      "formula": "count(distinct product_id) where product_id is not null",
      "numerator": "distinct non-null product_id",
      "denominator": null,
      "source_fields": ["product_id"],
      "allowed_windows": ["DAY", "FULL"],
      "additive": false,
      "null_policy": "null product_id is excluded",
      "limitations": ["DAY values cannot be summed to obtain an exact multi-day value."],
      "forbidden_claims": []
    },
    {
      "metric_name": "purchase_amount_proxy",
      "display_name": "购买事件金额合计（分析代理值）",
      "formula": "sum(price_decimal) where event_type = 'purchase'",
      "numerator": "purchase event price_decimal",
      "denominator": null,
      "source_fields": ["event_type", "price_decimal"],
      "allowed_windows": ["DAY", "FULL"],
      "additive": true,
      "null_policy": "invalid price fails publication",
      "limitations": ["No quantity, currency, discount, refund, cancellation, or payment state."],
      "forbidden_claims": ["GMV", "销售额", "收入"]
    },
    {
      "metric_name": "view_sessions",
      "display_name": "有浏览的会话数",
      "formula": "distinct non-null sessions with a view event",
      "numerator": "sessions with view",
      "denominator": null,
      "source_fields": ["user_session", "event_type"],
      "allowed_windows": ["DAY", "FULL"],
      "additive": false,
      "null_policy": "missing sessions are excluded and counted separately",
      "limitations": ["FULL is recomputed from the complete observation window."],
      "forbidden_claims": []
    },
    {
      "metric_name": "view_to_cart_sessions",
      "display_name": "浏览后加购会话数",
      "formula": "sessions with a cart at or after the first view ordering key",
      "numerator": "ordered view-to-cart sessions",
      "denominator": null,
      "source_fields": ["user_session", "event_type", "event_ts", "source_file", "source_row_number", "event_id"],
      "allowed_windows": ["DAY", "FULL"],
      "additive": false,
      "null_policy": "missing sessions are excluded and counted separately",
      "limitations": ["FULL is recomputed from ordered source facts."],
      "forbidden_claims": []
    },
    {
      "metric_name": "completed_sessions",
      "display_name": "完成漏斗会话数",
      "formula": "sessions with a purchase at or after the first eligible cart ordering key",
      "numerator": "ordered view-to-cart-to-purchase sessions",
      "denominator": null,
      "source_fields": ["user_session", "event_type", "event_ts", "source_file", "source_row_number", "event_id"],
      "allowed_windows": ["DAY", "FULL"],
      "additive": false,
      "null_policy": "missing sessions are excluded and counted separately",
      "limitations": ["A purchase event does not establish payment completion."],
      "forbidden_claims": ["支付完成会话"]
    },
    {
      "metric_name": "view_to_cart_rate",
      "display_name": "浏览到加购转化率",
      "formula": "view_to_cart_sessions / view_sessions",
      "numerator": "view_to_cart_sessions",
      "denominator": "view_sessions",
      "source_fields": ["user_session", "event_type", "event_ts", "source_file", "source_row_number", "event_id"],
      "allowed_windows": ["DAY", "FULL"],
      "additive": false,
      "null_policy": "zero denominator returns null",
      "limitations": ["FULL is recomputed from ordered source facts."],
      "forbidden_claims": []
    },
    {
      "metric_name": "cart_to_purchase_rate",
      "display_name": "加购到购买转化率",
      "formula": "completed_sessions / view_to_cart_sessions",
      "numerator": "completed_sessions",
      "denominator": "view_to_cart_sessions",
      "source_fields": ["user_session", "event_type", "event_ts", "source_file", "source_row_number", "event_id"],
      "allowed_windows": ["DAY", "FULL"],
      "additive": false,
      "null_policy": "zero denominator returns null",
      "limitations": ["A purchase event does not establish payment completion."],
      "forbidden_claims": ["支付转化率"]
    },
    {
      "metric_name": "full_conversion_rate",
      "display_name": "全漏斗转化率",
      "formula": "completed_sessions / view_sessions",
      "numerator": "completed_sessions",
      "denominator": "view_sessions",
      "source_fields": ["user_session", "event_type", "event_ts", "source_file", "source_row_number", "event_id"],
      "allowed_windows": ["DAY", "FULL"],
      "additive": false,
      "null_policy": "zero denominator returns null",
      "limitations": ["FULL is recomputed from ordered source facts."],
      "forbidden_claims": []
    },
    {
      "metric_name": "clean_event_count",
      "display_name": "正常路由事件数",
      "formula": "count(*) where quality_route = 'clean'",
      "numerator": "clean-routed facts",
      "denominator": null,
      "source_fields": ["quality_route", "event_id"],
      "allowed_windows": ["FULL"],
      "additive": true,
      "null_policy": "missing route is invalid",
      "limitations": ["Quality metrics are emitted as one FULL row in the first release."],
      "forbidden_claims": []
    },
    {
      "metric_name": "late_event_count",
      "display_name": "迟到路由事件数",
      "formula": "count(*) where quality_route = 'late'",
      "numerator": "late-routed facts",
      "denominator": null,
      "source_fields": ["quality_route", "event_id"],
      "allowed_windows": ["FULL"],
      "additive": true,
      "null_policy": "missing route is invalid",
      "limitations": ["Quality metrics are emitted as one FULL row in the first release."],
      "forbidden_claims": []
    },
    {
      "metric_name": "distinct_event_count",
      "display_name": "去重事件标识数",
      "formula": "count(distinct event_id)",
      "numerator": "distinct event_id",
      "denominator": null,
      "source_fields": ["event_id"],
      "allowed_windows": ["FULL"],
      "additive": false,
      "null_policy": "null event_id is invalid",
      "limitations": ["Quality metrics are emitted as one FULL row in the first release."],
      "forbidden_claims": []
    },
    {
      "metric_name": "duplicate_event_count",
      "display_name": "重复事件数",
      "formula": "count(*) - count(distinct event_id)",
      "numerator": "duplicate event difference",
      "denominator": null,
      "source_fields": ["event_id"],
      "allowed_windows": ["FULL"],
      "additive": false,
      "null_policy": "null event_id is invalid",
      "limitations": ["A non-zero value fails publication."],
      "forbidden_claims": []
    },
    {
      "metric_name": "missing_session_count",
      "display_name": "缺失会话事件数",
      "formula": "count(*) where user_session is null",
      "numerator": "facts with missing user_session",
      "denominator": null,
      "source_fields": ["user_session", "event_id"],
      "allowed_windows": ["FULL"],
      "additive": true,
      "null_policy": "missing sessions are retained as quality evidence",
      "limitations": ["Missing sessions are excluded from funnel denominators."],
      "forbidden_claims": []
    },
    {
      "metric_name": "unknown_category_count",
      "display_name": "未知品类事件数",
      "formula": "count(*) where category_code is null",
      "numerator": "facts with missing category display value",
      "denominator": null,
      "source_fields": ["category_id", "category_code", "event_id"],
      "allowed_windows": ["FULL"],
      "additive": true,
      "null_policy": "unknown categories remain explicit groups",
      "limitations": ["Category IDs are not inferred from missing display values."],
      "forbidden_claims": []
    },
    {
      "metric_name": "unknown_brand_count",
      "display_name": "未知品牌事件数",
      "formula": "count(*) where brand is null",
      "numerator": "facts with missing brand",
      "denominator": null,
      "source_fields": ["brand", "event_id"],
      "allowed_windows": ["FULL"],
      "additive": true,
      "null_policy": "unknown brands remain explicit groups",
      "limitations": ["Brands are not inferred from other product fields."],
      "forbidden_claims": []
    },
    {
      "metric_name": "invalid_event_type_count",
      "display_name": "非法事件类型数",
      "formula": "count(*) where event_type not in valid behavior types",
      "numerator": "facts with invalid event_type",
      "denominator": null,
      "source_fields": ["event_type", "event_id"],
      "allowed_windows": ["FULL"],
      "additive": true,
      "null_policy": "null event_type is invalid",
      "limitations": ["A non-zero value fails publication."],
      "forbidden_claims": []
    },
    {
      "metric_name": "empty_key_id_count",
      "display_name": "空关键标识数",
      "formula": "count(*) where event_id, user_id, or product_id is null or empty",
      "numerator": "facts with empty key identifiers",
      "denominator": null,
      "source_fields": ["event_id", "user_id", "product_id"],
      "allowed_windows": ["FULL"],
      "additive": true,
      "null_policy": "empty key identifiers are invalid",
      "limitations": ["A non-zero value fails publication."],
      "forbidden_claims": []
    },
    {
      "metric_name": "invalid_price_count",
      "display_name": "非法金额数",
      "formula": "count(*) where price_decimal is null",
      "numerator": "facts with invalid derived price",
      "denominator": null,
      "source_fields": ["price_decimal", "event_id"],
      "allowed_windows": ["FULL"],
      "additive": true,
      "null_policy": "invalid price fails publication",
      "limitations": ["Price is only an analysis proxy for purchase events."],
      "forbidden_claims": ["GMV", "销售额", "收入"]
    },
    {
      "metric_name": "invalid_derived_date_count",
      "display_name": "派生日期异常数",
      "formula": "count(*) where event_date or event_ts is null",
      "numerator": "facts with invalid derived date or timestamp",
      "denominator": null,
      "source_fields": ["event_time", "event_date", "event_ts", "event_id"],
      "allowed_windows": ["FULL"],
      "additive": true,
      "null_policy": "invalid derived date fails publication",
      "limitations": ["A non-zero value fails publication."],
      "forbidden_claims": []
    }
  ]
}
